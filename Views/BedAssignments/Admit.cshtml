@model PatientManagementSystem.Models.ViewModels.BedAssignmentViewModel
@{
    ViewData["Title"] = "Admit patient";
}

<div class="pms-page-header">
    <h1 class="pms-page-title">Admit</h1>
    <a asp-action="Index" class="pms-quick"><i class="bi bi-arrow-left"></i>Back</a>
</div>

<form asp-action="Admit" method="post">
    @Html.AntiForgeryToken()
    <div class="pms-card mb-3" style="max-width:680px;">
        <div class="pms-card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="PatientId" class="form-label small fw-semibold">Patient</label>
                    <select asp-for="PatientId" class="form-select pms-select2" data-placeholder="— Select patient —">
                        <option value=""></option>
                        @foreach (var p in Model.AvailablePatients)
                        {
                            <option value="@p.Id" selected="@(Model.PatientId == p.Id)">@p.FullName &middot; @p.Mrn</option>
                        }
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="BedId" class="form-label small fw-semibold">Bed</label>
                    <select asp-for="BedId" class="form-select pms-select2" data-placeholder="— Select bed —">
                        <option value=""></option>
                        @foreach (var b in Model.AvailableBeds)
                        {
                            <option value="@b.Id">@b.Display</option>
                        }
                    </select>
                    <span asp-validation-for="BedId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="AdmissionDate" class="form-label small fw-semibold"></label>
                    <input asp-for="AdmissionDate" class="form-control" type="date" value="@Model.AdmissionDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label small fw-semibold"></label>
                    <input asp-for="Notes" class="form-control" />
                </div>
            </div>
            @if (!ViewData.ModelState.IsValid)
            { <div class="alert alert-danger mt-3"><div asp-validation-summary="ModelOnly" class="mb-0"></div></div> }
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:10px;">Cancel</a>
        <button class="btn btn-primary" style="border-radius:10px;padding:0.55rem 1.2rem;font-weight:600;"><i class="bi bi-hospital me-1"></i>Admit</button>
    </div>
</form>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }