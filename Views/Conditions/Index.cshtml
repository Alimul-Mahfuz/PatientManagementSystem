@model IEnumerable<PatientManagementSystem.Models.ViewModels.ConditionViewModel>
@{
    ViewData["Title"] = "Conditions";
    var q = ViewData["q"] as string;
}

<div class="pms-page-header">
    <div>
        <h1 class="pms-page-title">Conditions</h1>
        <p class="pms-page-subtitle">Catalog of diagnoses (ICD-10) used in patient charts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2" style="border-radius:10px;padding:0.6rem 1.1rem;font-weight:600;">
            <i class="bi bi-plus-lg"></i>New condition
        </a>
    </div>
</div>

<div class="pms-card mb-3">
    <div class="pms-card-body">
        <form method="get" class="d-flex gap-2">
            <div class="input-group" style="max-width: 420px;">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="q" value="@q" class="form-control" placeholder="Search name or ICD-10 code..." />
            </div>
            <button type="submit" class="btn btn-outline-primary" style="border-radius:10px;"><i class="bi bi-funnel"></i></button>
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:10px;">Clear</a>
        </form>
    </div>
</div>

<div class="pms-card">
    <div class="pms-card-header"><i class="bi bi-heart-pulse me-2 text-primary"></i>All conditions</div>
    <div class="pms-card-body p-0">
        <div class="table-responsive">
            <table class="pms-table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ICD-10</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4"><div class="pms-empty"><i class="bi bi-inbox"></i>No conditions yet. Create one to get started.</div></td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@c.Name</span></td>
                            <td><span class="pms-pill is-muted">@(c.Icd10Code ?? "—")</span></td>
                            <td><span class="text-muted small">@(c.Description ?? "—")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light border me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Archive condition \'@c.Name\'?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger" title="Archive"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>