@model PatientManagementSystem.Models.ViewModels.InvoiceViewModel
@using PatientManagementSystem.Models.Enums
@{
    Layout = "_BaseLayout";
    ViewData["Title"] = $"Print Preview - Invoice {Model.Number}";
    var statusClass = Model.Status switch
    {
        InvoiceStatus.Paid => "text-success",
        InvoiceStatus.Cancelled => "text-danger",
        _ => "text-warning"
    };
}

@section HeadStyles {
    <style>
        .print-preview {
            max-width: 900px;
            margin: 0 auto;
            background: #fff;
            padding: 2rem;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .print-preview .invoice-header {
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }
        .print-preview .company-name {
            color: #0d6efd;
            font-size: 1.75rem;
            font-weight: 700;
        }
        .print-preview .invoice-title {
            color: #0d6efd;
            font-size: 2rem;
            font-weight: 700;
            text-align: right;
        }
        .print-preview .label {
            color: #6c757d;
            font-size: 0.875rem;
        }
        .print-preview .table th {
            background-color: #e7f1ff;
            color: #212529;
        }
        .print-preview .total-row {
            font-size: 1.25rem;
            font-weight: 700;
            color: #0d6efd;
        }
        .print-actions {
            max-width: 900px;
            margin: 0 auto 1rem;
        }
        @@media print {
            .print-actions,
            .navbar,
            .footer,
            .pms-sidebar {
                display: none !important;
            }
            .print-preview {
                border: none;
                box-shadow: none;
                padding: 0;
                max-width: 100%;
            }
            body {
                background: #fff;
            }
        }
    </style>
}

<div class="print-actions d-flex justify-content-between align-items-center">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <div class="d-flex gap-2">
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="btn btn-primary" target="_blank">
            <i class="bi bi-printer"></i> Print
        </a>
    </div>
</div>

<div class="print-preview">
    <div class="invoice-header d-flex justify-content-between align-items-end">
        <div>
            <div class="company-name">Patient Management System</div>
        </div>
        <div class="invoice-title">INVOICE</div>
    </div>

    <div class="row mb-4">
        <div class="col-sm-6">
            <div class="mb-1"><span class="label">Invoice #:</span> <strong>@Model.Number</strong></div>
            <div class="mb-1"><span class="label">Status:</span> <strong class="@statusClass">@Model.Status</strong></div>
        </div>
        <div class="col-sm-6 text-sm-end">
            <div class="mb-1"><span class="label">Date:</span> <strong>@Model.InvoiceDate.ToString("dd MMM yyyy")</strong></div>
        </div>
    </div>

    <div class="mb-4">
        <div class="label">Bill To</div>
        <div class="fw-bold fs-5">@(ViewData["PatientName"] ?? "—")</div>
        <div class="text-muted">MRN: @(ViewData["PatientMrn"] ?? "—")</div>
    </div>

    <table class="table table-bordered mb-4">
        <thead>
            <tr>
                <th>Description</th>
                <th class="text-center" style="width: 80px;">Qty</th>
                <th class="text-end" style="width: 130px;">Unit Price</th>
                <th class="text-end" style="width: 130px;">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Description</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                    <td class="text-end fw-semibold">@item.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row">
        <div class="col-sm-6">
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="label">Notes</div>
                <div class="text-muted">@Model.Notes</div>
            }
        </div>
        <div class="col-sm-6">
            <div class="d-flex justify-content-between mb-1">
                <span class="label">Subtotal</span>
                <span>@Model.SubTotal.SubTotal.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="label">Tax (@Model.TaxPercent.ToString("0.##")%)</span>
                <span>@Model.TaxAmount.ToString("N2")</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between total-row">
                <span>TOTAL</span>
                <span>@Model.Total.ToString("N2") NPR</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                window.open('@Url.Action("Pdf", new { id = Model.Id })', '_blank');
            }
        });
    </script>
}
