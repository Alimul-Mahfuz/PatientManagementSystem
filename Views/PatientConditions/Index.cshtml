@model PatientManagementSystem.Models.ViewModels.PatientConditionViewModel
@using PatientManagementSystem.Models.Enums
@{
    ViewData["Title"] = "Patient conditions";
    var patientConditions = ViewData["PatientConditions"] as List<PatientManagementSystem.Models.ViewModels.PatientConditionViewModel> ?? new();
}

<div class="pms-page-header">
    <div>
        <h1 class="pms-page-title">Conditions for @Model.PatientName</h1>
        <p class="pms-page-subtitle"><span class="text-muted small">@Model.PatientMrn</span></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="pms-quick"><i class="bi bi-arrow-left"></i>Patient</a>
    </div>
</div>

<div class="pms-card mb-3">
    <div class="pms-card-header"><i class="bi bi-clipboard2-plus me-2 text-primary"></i>Add a condition</div>
    <div class="pms-card-body">
        <form asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label asp-for="ConditionId" class="form-label small fw-semibold">Condition</label>
                    <select asp-for="ConditionId" class="form-select pms-select2" data-placeholder="— Select condition —">
                        <option value=""></option>
                        @foreach (var c in Model.AvailableConditions)
                        {
                            <option value="@c.Id">@c.Name @(c.Icd10Code != null ? $"({c.Icd10Code})" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label asp-for="DiagnosedDate" class="form-label small fw-semibold"></label>
                    <input asp-for="DiagnosedDate" class="form-control" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-2">
                    <label asp-for="Severity" class="form-label small fw-semibold"></label>
                    <select asp-for="Severity" asp-items="Html.GetEnumSelectList<Severity>()" class="form-select pms-select2"></select>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Notes" class="form-label small fw-semibold"></label>
                    <input asp-for="Notes" class="form-control" placeholder="Brief notes" />
                </div>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-primary" style="border-radius:10px;"><i class="bi bi-plus-lg me-1"></i>Add</button>
            </div>
        </form>
    </div>
</div>

<div class="pms-card">
    <div class="pms-card-header"><i class="bi bi-list-check me-2 text-primary"></i>Diagnoses</div>
    <div class="pms-card-body p-0">
        <div class="table-responsive">
            <table class="pms-table mb-0">
                <thead>
                    <tr>
                        <th>Condition</th>
                        <th>ICD-10</th>
                        <th>Diagnosed</th>
                        <th>Severity</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!patientConditions.Any())
                    {
                        <tr><td colspan="7"><div class="pms-empty"><i class="bi bi-inbox"></i>No conditions on record.</div></td></tr>
                    }
                    @foreach (var pc in patientConditions)
                    {
                        var sev = pc.Severity switch
                        {
                            Severity.Mild => "is-success",
                            Severity.Moderate => "is-info",
                            Severity.Severe => "is-warning",
                            Severity.Critical => "is-danger",
                            _ => "is-muted"
                        };
                        <tr>
                            <td><span class="fw-semibold">@pc.ConditionName</span></td>
                            <td><span class="pms-pill is-muted">@(pc.Icd10Code ?? "—")</span></td>
                            <td><span class="text-muted small">@pc.DiagnosedDate.ToString("dd MMM yyyy")</span></td>
                            <td><span class="pms-pill @sev">@pc.Severity</span></td>
                            <td>
                                @if (pc.IsResolved)
                                { <span class="pms-pill is-success"><i class="bi bi-check2"></i>Resolved @pc.ResolvedDate?.ToString("dd MMM")</span> }
                                else
                                { <span class="pms-pill is-warning">Active</span> }
                            </td>
                            <td><span class="text-muted small">@(pc.Notes ?? "—")</span></td>
                            <td class="text-end text-nowrap">
                                @if (!pc.IsResolved)
                                {
                                    <form asp-action="Resolve" asp-route-id="@pc.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-light border text-success me-1" title="Mark resolved"><i class="bi bi-check2-circle"></i></button>
                                    </form>
                                }
                                <form asp-action="Remove" asp-route-id="@pc.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this condition?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>