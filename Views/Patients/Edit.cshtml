@model PatientManagementSystem.Models.ViewModels.PatientEditViewModel
@using PatientManagementSystem.Models.Enums
@{
    ViewData["Title"] = "Edit patient";
}

<div class="pms-page-header">
    <div>
        <h1 class="pms-page-title">Edit patient</h1>
        <p class="pms-page-subtitle">@Model.FullName &middot; <span class="text-muted small">@Model.Mrn</span></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="pms-quick"><i class="bi bi-eye"></i>View</a>
        <a asp-action="Index" class="pms-quick"><i class="bi bi-arrow-left"></i>Back</a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />

    <div class="pms-card mb-3">
        <div class="pms-card-header"><i class="bi bi-person-vcard me-2 text-primary"></i>Identity</div>
        <div class="pms-card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Mrn" class="form-label small fw-semibold"></label>
                    <input asp-for="Mrn" class="form-control" />
                    <span asp-validation-for="Mrn" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-5">
                    <label asp-for="FullName" class="form-label small fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Gender" class="form-label small fw-semibold"></label>
                    <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select pms-select2"></select>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="DateOfBirth" class="form-label small fw-semibold"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="BloodGroup" class="form-label small fw-semibold"></label>
                    <select asp-for="BloodGroup" class="form-select pms-select2" data-placeholder="— Select —">
                        <option value=""></option>
                        <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
                        <option>AB+</option><option>AB-</option><option>O+</option><option>O-</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Status" class="form-label small fw-semibold"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<PatientStatus>()" class="form-select pms-select2"></select>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pms-card mb-3">
        <div class="pms-card-header"><i class="bi bi-telephone me-2 text-primary"></i>Contact</div>
        <div class="pms-card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Phone" class="form-label small fw-semibold"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Email" class="form-label small fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="EmergencyContact" class="form-label small fw-semibold"></label>
                    <input asp-for="EmergencyContact" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label small fw-semibold"></label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="pms-card mb-3">
        <div class="pms-card-header"><i class="bi bi-heart-pulse me-2 text-primary"></i>Medical</div>
        <div class="pms-card-body">
            <label asp-for="Allergies" class="form-label small fw-semibold"></label>
            <textarea asp-for="Allergies" class="form-control" rows="2"></textarea>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger"><div asp-validation-summary="ModelOnly" class="mb-0"></div></div>
    }

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:10px;">Cancel</a>
        <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:0.55rem 1.2rem;font-weight:600;">
            <i class="bi bi-save me-1"></i>Save changes
        </button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}