@model PatientManagementSystem.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var pwModel = ViewData["PasswordModel"] as PatientManagementSystem.Models.ViewModels.ChangePasswordViewModel
                  ?? new PatientManagementSystem.Models.ViewModels.ChangePasswordViewModel();
    var initials = (Model.FullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.FirstOrDefault()).Take(2).ToArray();
    var initialsStr = new string(initials).ToUpper();
    if (string.IsNullOrEmpty(initialsStr)) initialsStr = "?";
}

<div class="pms-page-header">
    <div>
        <h1 class="pms-page-title">My profile</h1>
        <p class="pms-page-subtitle">View and update your account details.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="pms-quick"><i class="bi bi-arrow-left"></i>Dashboard</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="pms-card mb-3">
            <div class="pms-card-body text-center">
                <div class="d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 96px; height: 96px; border-radius: 50%;
                            background: linear-gradient(135deg, #2563eb, #0ea5e9);
                            color: #fff; font-size: 2rem; font-weight: 700;">
                    @initialsStr
                </div>
                <h5 class="mb-1 fw-bold">@Model.FullName</h5>
                <p class="text-muted small mb-2">@Model.Email</p>
            </div>
        </div>

        <div class="pms-card">
            <div class="pms-card-header">
                <i class="bi bi-info-circle me-2 text-primary"></i>Account summary
            </div>
            <div class="pms-card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Member since</span>
                        <span class="small">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Status</span>
                        <span class="pms-pill is-success">Active</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="pms-card mb-3">
            <div class="pms-card-header">
                <i class="bi bi-person-lines-fill me-2 text-primary"></i>Personal information
            </div>
            <div class="pms-card-body">
                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+977-..." />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" readonly />
                            </div>
                            <small class="text-muted">Email is the sign-in handle and cannot be self-changed.</small>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Created</label>
                            <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd MMM yyyy")" readonly />
                        </div>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData["PasswordModel"] == null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }
                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary" style="border-radius:10px; padding:0.55rem 1.2rem; font-weight:600;">
                            <i class="bi bi-save me-1"></i>Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="pms-card">
            <div class="pms-card-header">
                <i class="bi bi-key me-2 text-primary"></i>Change password
            </div>
            <div class="pms-card-body">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="CurrentPassword" class="form-label small fw-semibold">Current password</label>
                            <input id="CurrentPassword" name="CurrentPassword" type="password" class="form-control" autocomplete="current-password" value="@pwModel.CurrentPassword" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="CurrentPassword"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="NewPassword" class="form-label small fw-semibold">New password</label>
                            <input id="NewPassword" name="NewPassword" type="password" class="form-control" autocomplete="new-password" value="@pwModel.NewPassword" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="NewPassword"></span>
                            <small class="text-muted">Min 8 chars, with uppercase, digit, and symbol.</small>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="ConfirmPassword" class="form-label small fw-semibold">Confirm new password</label>
                            <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" value="@pwModel.ConfirmPassword" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="ConfirmPassword"></span>
                        </div>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData["PasswordModel"] != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }
                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary" style="border-radius:10px; padding:0.55rem 1.2rem; font-weight:600;">
                            <i class="bi bi-shield-lock me-1"></i>Update password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}