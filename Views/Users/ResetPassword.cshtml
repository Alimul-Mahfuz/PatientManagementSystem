@model PatientManagementSystem.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="pms-page-header">
    <div>
        <h1 class="pms-page-title">Reset password</h1>
        <p class="pms-page-subtitle">Force a new password for <span class="text-dark">@Model.Email</span>.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="pms-quick"><i class="bi bi-arrow-left"></i>Back</a>
    </div>
</div>

<form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />

    <div class="pms-card mb-3" style="max-width: 540px;">
        <div class="pms-card-header"><i class="bi bi-key me-2 text-primary"></i>New password</div>
        <div class="pms-card-body">
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <small class="text-muted d-block">Min 8 chars, with uppercase, digit, and symbol.</small>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-0">
                    <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:10px;">Cancel</a>
        <button type="submit" class="btn btn-primary" style="border-radius:10px; padding:0.55rem 1.2rem; font-weight:600;">
            <i class="bi bi-shield-lock me-1"></i>Reset password
        </button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}